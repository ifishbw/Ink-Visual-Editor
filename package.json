{
  "name": "inkvisual",
  "productName": "InkVisual",
  "version": "0.1.0",
  "private": true,
  "description": "A graph-based editor and viewer for inkle's ink narrative scripting language",
  "author": {
    "name": "ifishbw",
    "email": "westlake.benjamin@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/ifishbw/Ink-Visual-Editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/ifishbw/Ink-Visual-Editor.git"
  },
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dump": "tsx scripts/dump.ts"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/highlight": "^1.2.3",
    "@mavnn/codemirror-lang-ink": "^0.10.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.6",
    "chokidar": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "inkjs": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "zustand": "^5.0.15"
  }
}
